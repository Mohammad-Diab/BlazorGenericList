@page "/"
<h1>Hello, Blazor!</h1>


<div class="custom-control custom-checkbox mb-3">
    <input type="checkbox" class="custom-control-input" id="isAdmin-btn" @bind="IsAdmin">
    <label class="custom-control-label" for="isAdmin-btn">Is Admin?</label>
</div>

<GenericGrid ItemsList="list" IsAdmin="IsAdmin" AddItem="AddUser">
    <tableHeader>
        <TableHeader SortFunc="SortList" Headers="headers"></TableHeader>
    </tableHeader>
    <itemRender>
        <UserItem user="context" IsAdmin="IsAdmin" DeleteUser="DeleteUser" />
    </itemRender>
</GenericGrid>


@code {
    List<User> list;
    bool IsAdmin = true;
    Random rand = new Random();


    List<string> headers = new List<string>() { "Id", "Name", "Birthday" };

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(1000);
        list = new List<User>();
        list.Add(new User() { Name = "Samer", Birthday = new DateTime(1960, 1, 15) });
        list.Add(new User() { Name = "Ahmad", Birthday = new DateTime(2000, 5, 20) });
        list.Add(new User() { Name = "Mohammad", Birthday = new DateTime(1975, 6, 8) });
        list.Add(new User() { Name = "Fadi", Birthday = new DateTime(1995, 12, 1) });
    }


    void SortList(int index)
    {
        int multiplay = 1;
        if (index < 0)
        {
            multiplay = -1;
            index *= -1;
        }
        Console.WriteLine(multiplay);
        switch (index)
        {
            case 1:
                list.Sort((x, y) => multiplay * (x.Id.CompareTo(y.Id)));
                break;
            case 2:
                list.Sort((x, y) => multiplay * (x.Name.CompareTo(y.Name)));
                break;
            case 3:
                list.Sort((x, y) => multiplay * (x.Birthday.CompareTo(y.Birthday)));
                break;

        };
    }

    void AddUser()
    {
        User u = new User() { Name = "New User", Birthday = new DateTime(rand.Next(1950, 2019), rand.Next(1, 13), rand.Next(1, 29)) };
        if (list == null)
        {
            list = new List<User>();
        }
        list.Add(u);
        //SortList(sortIndex);
    }

    void DeleteUser(User u)
    {
        if (u != null)
        {
            list.Remove(u);
        }
    }
}