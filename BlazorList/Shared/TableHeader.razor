<tr>
    @for (int i = 0; i < Headers.Count; i++)
    {
        int index = i + 1;
    <th>
        @if (Math.Abs(lastSortIndex) == index)
        {
            <span class="oi align-middle oi-sort-@(lastSortIndex > -1 ? "ascending" : "descending")"></span>
        }
        <a class="btn-link pl-1" href="javascript:void(0)" @onclick="()=> { SortBy(index); }">@Headers[i]</a>
    </th>
    }
    <th>
        <a class="btn-link">Actions</a>
    </th>
</tr>

@code {
    [Parameter] public List<string> Headers { get; set; }
    [Parameter] public EventCallback<int> SortFunc { get; set; }

    int lastSortIndex = 1;

    void SortBy(int index)
    {
        Console.WriteLine("Sorting...");
        Console.WriteLine($"lastSortIndex = {lastSortIndex}");
        Console.WriteLine($"index = {index}");
        if (Math.Abs(lastSortIndex) == index)
        {
            lastSortIndex = -lastSortIndex;
        }
        else
        {
            lastSortIndex = index;
        }
        SortFunc.InvokeAsync(lastSortIndex);
    }
}
