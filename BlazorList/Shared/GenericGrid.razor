@typeparam TItem
@if (IsAdmin)
{
    <div class="mt-1 mb-3">
        <button class="btn btn-primary" @onclick="AddItem">
            <span class="oi oi-plus"></span>
            <span>Add</span>
        </button>
    </div>
}


@if (ItemsList == null)
{
    <text>Loading...</text>
}
else if (ItemsList.Count == 0)
{
    <text>No item to show.</text>
}
else
{
    <table style="table-layout: fixed" class="table">
        <thead>
            @tableHeader
        </thead>
        <tbody>
            @for (int i = 0; i < ItemsList.Count; i++)
            {
                int index = i;
                @itemRender(ItemsList[i]);
            } 
        </tbody>
    </table>
}

@code {
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public List<TItem> ItemsList { get; set; }
    [Parameter] public RenderFragment tableHeader { get; set; }
    [Parameter] public RenderFragment<TItem> itemRender { get; set; }
    [Parameter] public EventCallback AddItem { get; set; }
}
