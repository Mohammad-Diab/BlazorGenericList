@typeparam TItem

@if (list == null)
{
    <text>Loading...</text>
}
else if (list.Count == 0)
{
    <text>No item to show.</text>
}
else
{
    <table style="table-layout: fixed" class="table">
        <thead>
            @tableHeader
        </thead>
        <tbody>
            @foreach (var item in list)
            {
                @itemRender(item)
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public List<TItem> list { get; set; }
    [Parameter] public RenderFragment tableHeader { get; set; }
    [Parameter] public RenderFragment<TItem> itemRender { get; set; }
}
